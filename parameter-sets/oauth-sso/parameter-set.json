{
    "meta": {
        "label": "OData Azure SSO",
        "description": "",
        "icon": "icon-cloud"
    },
    "defaultDefinableInline": false,
    "defaultDefinableAtProjectLevel": false,
    "pluginParams": [
    ],
    "params": [
        {
            "name": "odata_instance",
            "label": "Resource",
            "type": "STRING",
            "description": "URL to the .svc resource, e.g. https://services.odata.org/V3/OData/OData.svc/",
            "mandatory": true
        },
        {
            "name": "odata_version",
            "label": "OData protocol version",
            "type": "SELECT",
            "defaultValue" : "v4",
            "selectChoices": [
                {
                    "value": "v2",
                    "label": "Version 2"
                },
                {
                    "value": "v3",
                    "label": "Version 3"
                },
                {
                    "value": "v4",
                    "label": "Version 4"
                }
            ]
        },
        {
            "name": "odata_oauth",
            "label": "Azure credentials",
            "type": "CREDENTIAL_REQUEST",
            "credentialRequestSettings": {
                "type": "OAUTH2",
                "authorizationEndpoint": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
                "tokenEndpoint": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
                "scope": "offline_access files.read.all files.readwrite files.readwrite.all"
            }
        },
        {
            "name": "authorizationEndpoint",
            "label": "Authorization endpoint",
            "type": "STRING",
            "description": "Optional, see documentation",
            "mandatory": false
        },
        {
            "name": "tokenEndpoint",
            "label": "Token endpoint",
            "type": "STRING",
            "description": "Optional, see documentation",
            "mandatory": false
        },
        {
            "name": "scope",
            "label": "Scopes",
            "type": "STRING",
            "description": "Optional, see documentation",
            "mandatory": false
        }
    ]
}
